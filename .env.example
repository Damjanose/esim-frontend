# Copy to .env.local and fill in. Values prefixed NEXT_PUBLIC_ are inlined into
# the client bundle at build time — restart `next dev` after changing them.

# Backend API base. Defaults to the local backend when unset.
# BACKEND_API_URL=http://127.0.0.1:4000/api
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api

# Absolute origin of this site, used for canonical URLs / redirects.
# PUBLIC_SITE_ORIGIN=http://localhost:3000

# Google Identity Services web client id. Must match the backend's
# GOOGLE_WEB_CLIENT_ID. When empty, the Google button is not rendered.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Apple Services ID (web Sign in with Apple), e.g. com.uplisoft.velocityesim.web.
# Must match the backend's APPLE_SERVICES_ID. When empty, the Apple button is not
# rendered — which is the correct state until the portal entry exists.
#
# This is NOT the app bundle id (Apple forbids the two being equal) and NOT a
# Google client id. A Google id here renders the button and fails `invalid_client`.
# Register it under the same primary App ID as the mobile app so one user gets one
# `sub` across both, and add this site's origin + `<origin>/signin` return URL.
NEXT_PUBLIC_APPLE_SERVICES_ID=
