# Committed on purpose. `update.sh` deploys with `git pull` and then builds on
# the server, and NEXT_PUBLIC_* values are inlined into the client bundle at
# build time — so anything not in git is simply absent in production. That is
# why the Google button never rendered on the live /signin: `.env.local` is
# gitignored and has never existed on the server.
#
# Nothing secret belongs here. Every value below ships inside the public JS
# bundle by definition; treat this file as public. Real secrets
# (BACKEND_API_URL credentials, admin tokens) stay server-side.
#
# `.env.local` still wins locally, so your machine keeps overriding these.

# Google Identity Services web client id. Must match the backend's
# GOOGLE_WEB_CLIENT_ID or the backend rejects the token's `aud`.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=275860271813-vt4mc58083hskh030i90p2cpvnih1ito.apps.googleusercontent.com

# Sign in with Apple on the web needs a *Services ID* (com.something.web),
# which does not exist yet — see docs/sessions/2026-08-13_social_signin_env_wiring.md.
# Deliberately left unset so the Apple button stays hidden rather than
# rendering and failing. Do not paste a Google client id here.
NEXT_PUBLIC_APPLE_SERVICES_ID=275860271813-iq11qhopopcu46da2g7qjpcfu2amd1bl.apps.googleusercontent.com