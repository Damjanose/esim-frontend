# Google Identity Services web client id. Must match the backend's
# GOOGLE_WEB_CLIENT_ID or the backend rejects the token's `aud`.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=275860271813-vt4mc58083hskh030i90p2cpvnih1ito.apps.googleusercontent.com

# Sign in with Apple on the *web* uses a Services ID, not the app bundle id and
# not a Google client id (a Google id here makes the button render and then fail
# with `invalid_client`).
#
# Apple does not allow the Services ID to equal the App ID, so it cannot literally
# be `com.uplisoft.velocityesim`. Register it in the Apple Developer portal under
# the *same* primary App ID (`com.uplisoft.velocityesim`, team R72R8C56GK) — that
# grouping is what makes Apple issue one shared `sub` for a user across the mobile
# app and the web, so both sign into the same account.
#
# Return URL for local dev: http://localhost:3000/signin
# (must match `redirectURI` in src/app/signin/SocialSignInButtons.tsx)
NEXT_PUBLIC_APPLE_SERVICES_ID=com.uplisoft.velocityesim.web

BACKEND_API_URL=https://esim.uplisoft.com/api
NEXT_PUBLIC_SOCKET_URL=https://esim.uplisoft.com
